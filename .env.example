# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# PostgreSQL Configuration
POSTGRES_URI=postgresql://user:password@localhost:5432/erp_db

# OpenAI Configuration (for DSPy)
OPENAI_API_KEY=sk-your_openai_api_key

# LangSmith Configuration (for evaluation tracking)
LANGSMITH_API_KEY=ls-your_langsmith_api_key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=construction-graph-rag

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
